# Normalize all text files to LF in the repository; Git handles checkout
# per-platform (Windows contributors get CRLF, cPanel servers need LF).
* text=auto eol=lf

# Binary assets — never diff or normalize these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Mark vendor deps and lockfiles so diffs stay readable and GitHub
# uses the right language statistics.
core/vendor/** linguist-vendored
core/composer.lock linguist-generated=true
core/package-lock.json linguist-generated=true
