<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- v1.7.5: the Arch suite was NEVER registered here, so
             BladeFormVerbTest, MigrationDropGuardTest and NoBladeLeakTest
             had not run once — three guards the handoff cites as
             permanent repo-wide enforcement. Arch tests need no database;
             they are static scans. Registering them is what makes the new
             UserAvatarGeometryTest (the v1.7.5 frame-geometry ban) a real
             release gate rather than dead code. -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="database"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- No Redis/Memcached in CI either: exercise the same database drivers prod uses -->
        <env name="QUEUE_CONNECTION" value="database"/>
        <env name="SESSION_DRIVER" value="database"/>
        <!-- Search must be synchronous + real in feature tests: assert results directly -->
        <env name="SCOUT_DRIVER" value="database"/>
        <env name="SCOUT_QUEUE" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
