# =============================================================
# PromptSewa — cPanel Optimized Configuration
# Local dev uses SQLite; cPanel production uses MySQL/MariaDB.
# =============================================================

APP_NAME=PromptSewa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# On cPanel this is typically https://yourdomain.com (no subdirectory).
APP_URL=http://promptvellum.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# -------------------------------------------------------------
# DATABASE — SQLite locally; switch to mysql on cPanel
# (cPanel gives you a prefixed DB name/user, e.g. cpaneluser_pv)
# -------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost            # cPanel MySQL is almost always "localhost" (socket), not 127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cpaneluser_promptvellum
# DB_USERNAME=cpaneluser_pv
# DB_PASSWORD=secret

# -------------------------------------------------------------
# SESSIONS / CACHE / QUEUES — cPanel constraint: NO Redis/Memcached.
# database driver = zero extra daemons, survives reboots, all
# state lives in the same MySQL DB the host already provides.
# -------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

# -------------------------------------------------------------
# SEARCH — Laravel Scout. "database" engine searches the model's
# own columns (LIKE on SQLite/local, MySQL FULLTEXT on cPanel) —
# zero external services. Phase 4 VPS: SCOUT_DRIVER=meilisearch.
# Never write raw MATCH()/LIKE in controllers — always Prompt::search().
# -------------------------------------------------------------
SCOUT_DRIVER=database
SCOUT_QUEUE=false

CACHE_STORE=database
CACHE_PREFIX=promptvellum

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------
# PROMPTVELLUM APP SETTINGS (config/promptvellum.php)
# -------------------------------------------------------------
# Cron/scheduler failure alerts are sent to this address.
DEPLOY_ALERT_EMAIL=

# Marketplace / Finance (Sprint 2)
PLATFORM_FEE_PERCENT=20
CURRENCY=NPR

# -------------------------------------------------------------
# PAYMENT GATEWAYS — secrets live ONLY in .env, never in the DB.
# ESEWA_SECRET_KEY is the HMAC-SHA256 merchant secret from eSewa.
# -------------------------------------------------------------
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc.esewa.com.np

# -------------------------------------------------------------
# BACKBLAZE B2 (optional, S3-compatible, cheap off-server media)
# Leave FILESYSTEM_DISK=local to keep media in storage/app/public.
# -------------------------------------------------------------
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-west-004
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_ENDPOINT=https://s3.us-west-004.backblazeb2.com

VITE_APP_NAME="${APP_NAME}"
